# =============================================================================
# CPaaS local development environment
# Copy to .env and adjust values
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://cpaas:cpaas_secret@localhost:5432/cpaas?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT / Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
API_KEY_PEPPER=change-me-api-key-pepper-min-32-chars!!
OTP_PEPPER=change-me-otp-pepper-min-32-chars-long!!!!
WEBHOOK_SIGNING_SECRET=change-me-webhook-signing-secret!!!!!!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# App URLs
API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# S3-compatible storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cpaas
S3_FORCE_PATH_STYLE=true

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=cpaas-api

# SMTP (local Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@cpaas.local

# Provider credentials (optional for local; Android gateway works without these)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MSG91_AUTH_KEY=
VONAGE_API_KEY=
VONAGE_API_SECRET=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
EXOTEL_SID=
EXOTEL_TOKEN=
SPRINGEDGE_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
AWS_SES_REGION=
