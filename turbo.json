{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "API_KEY_PEPPER",
    "OTP_PEPPER",
    "WEBHOOK_SIGNING_SECRET",
    "ENCRYPTION_KEY",
    "NODE_ENV",
    "PORT",
    "API_URL",
    "CORS_ORIGINS",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_FROM",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "LOG_LEVEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "generate": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
